{
  "schema_version": "cmb.gematria-anomaly-evaluation.v1",
  "protocol": "GEMATRIA-GLITCH-1",
  "name": "Gematria Glitch Anomaly Evaluation",
  "status": "experimental_bounded_analysis",
  "purpose": "Evaluate whether repository agents can calculate, discover, challenge, explain, and render Gematria relationships while preserving epistemic boundaries.",
  "invariants": [
    "PATTERN != PROOF",
    "NUMERIC_EQUALITY != SEMANTIC_IDENTITY",
    "SYMBOLISM != CAUSATION",
    "ODDITY != DESTINY",
    "INTERPRETATION -> HUMAN",
    "HUMAN_AGENCY > MACHINE_AUTHORITY",
    "RARITY != SIGNIFICANCE",
    "RECEIPT != TRUTH",
    "GRAPH != PROOF",
    "EDGE != CAUSATION",
    "CONNECTED != IDENTICAL",
    "PATH != PROOF",
    "PATH_RANK != TRUTH",
    "NO_PATH != NO_RELATIONSHIP",
    "REPLICATION != PROOF",
    "RECURRENCE != CAUSATION",
    "REPEATED != UNIVERSAL",
    "CORPUS_DEPENDENCE != FALSEHOOD",
    "ABSENCE != DISPROOF",
    "NULL_MODEL != REALITY",
    "EMPIRICAL_P_VALUE != TRUTH_PROBABILITY",
    "SURPRISE != SIGNIFICANCE",
    "RARE_UNDER_NULL != SUPERNATURAL",
    "BH_Q_VALUE != TRUTH_PROBABILITY",
    "MULTIPLE_TESTING_CORRECTION != SEMANTIC_PROOF",
    "NULL_MODEL_ENSEMBLE != REALITY",
    "ROBUST_ACROSS_MODELS != TRUTH",
    "MODEL_AGREEMENT != CAUSATION",
    "Q_THRESHOLD != SEMANTIC_THRESHOLD",
    "ASSUMPTION_SENSITIVITY != FALSEHOOD"
  ],
  "pipeline": [
    "SENSE",
    "CALCULATE",
    "CLASSIFY",
    "CONNECT",
    "FALSIFY",
    "TRACE",
    "RANK",
    "RECEIPT",
    "GRAPH",
    "PATH_QUERY",
    "REPLICATE",
    "NULL_TEST",
    "NULL_ENSEMBLE",
    "RENDER",
    "HUMAN_INTERPRETATION"
  ],
  "roles": [
    {
      "id": "GEMATRIA_RECEPTOR",
      "task": "Accept a declared Hebrew corpus and Gematria system.",
      "authority": "read_only"
    },
    {
      "id": "ARITHMETIC_CELL",
      "task": "Calculate deterministic Gematria values and mathematical classifications.",
      "authority": "read_only"
    },
    {
      "id": "ODDITY_SCOUT",
      "task": "Detect reproducible numerical structures.",
      "authority": "read_only"
    },
    {
      "id": "CONNECTION_WEAVER",
      "task": "Propose a connection only when a reproducible numerical or linguistic mechanism is present.",
      "authority": "propose_only"
    },
    {
      "id": "FALSIFIER_CELL",
      "task": "Search for arithmetic mistakes and simpler mechanical explanations.",
      "authority": "read_only"
    },
    {
      "id": "GLITCH_SCRIBE",
      "task": "Render verified findings using GEMATRIA-GLITCH-1 glyph operators.",
      "authority": "write_artifact_only"
    },
    {
      "id": "GRAPH_WEAVER",
      "task": "Project corpus records and verified receipt-backed relationships into a deterministic typed anomaly graph.",
      "authority": "write_artifact_only"
    },
    {
      "id": "PATHFINDER_CELL",
      "task": "Search bounded simple paths in the verified anomaly graph, rank by evidence floor and hop count, and return receipt and source traces.",
      "authority": "read_only"
    },
    {
      "id": "REPLICATION_CELL",
      "task": "Compare canonical anomaly signatures and anomaly-type recurrence across multiple provenance-grade corpora using the same Gematria system.",
      "authority": "read_only"
    },
    {
      "id": "NULL_MODEL_CELL",
      "task": "Run deterministic value-permutation baselines, reject ambiguous duplicate word tokens, and report raw empirical p-values plus Benjamini-Hochberg adjusted q-values without converting statistical rarity into truth.",
      "authority": "read_only"
    },
    {
      "id": "NULL_ENSEMBLE_CELL",
      "task": "Compare observed findings across unrestricted and word-length-stratified permutation baselines, then report cross-model q-value robustness without converting model agreement into truth.",
      "authority": "read_only"
    }
  ],
  "cases": [
    {
      "id": "GGL-001",
      "input": [
        "נחש",
        "משיח"
      ],
      "expected": "EXACT_COLLISION",
      "evidence": "358 == 358",
      "allowed": true,
      "reject": "Equal values alone do not make the concepts identical."
    },
    {
      "id": "GGL-002",
      "input": [
        "הנחש"
      ],
      "expected": "PALINDROME",
      "evidence": "363 == reverse(363)",
      "allowed": true,
      "reject": "A palindrome alone does not establish destiny."
    },
    {
      "id": "GGL-003",
      "input": [
        "אמת"
      ],
      "expected": "PERFECT_SQUARE",
      "evidence": "441 = 21 * 21",
      "allowed": true,
      "reject": "A square relationship is arithmetic, not semantic proof."
    },
    {
      "id": "GGL-004",
      "input": [
        "אדם"
      ],
      "expected": "TRIANGULAR_NUMBER",
      "evidence": "45 = T(9)",
      "allowed": true,
      "reject": "A triangular value alone does not govern a person."
    },
    {
      "id": "GGL-005",
      "input": [
        "לב"
      ],
      "expected": "POWER_OF_TWO",
      "evidence": "32 = 2^5",
      "allowed": true,
      "reject": "The numerical structure is not a literal model of a heart."
    },
    {
      "id": "GGL-006",
      "input": [
        "חכמה"
      ],
      "expected": "PRIME_VALUE",
      "evidence": "73 is prime",
      "allowed": true,
      "reject": "Prime structure alone does not establish superior meaning."
    },
    {
      "id": "GGL-007",
      "input": [
        "שלום",
        "תורה"
      ],
      "expected": "SHARED_PRIME_FACTOR",
      "evidence": "376 and 611 share prime factor 47",
      "allowed": true,
      "reject": "A shared factor alone does not establish causation."
    },
    {
      "id": "GGL-008",
      "input": [
        "נחש",
        "הנחש"
      ],
      "expected": "LINGUISTIC_PREFIX_DELTA",
      "evidence": "363 - 358 = 5 and ה = 5",
      "allowed": true,
      "reject": "The delta should be explained by the prefix before symbolic interpretation."
    },
    {
      "id": "GGL-009",
      "input": [
        "אהבה",
        "אחד"
      ],
      "expected": "EXACT_COLLISION",
      "evidence": "13 == 13",
      "allowed": true,
      "reject": "Numeric equality does not force semantic identity."
    },
    {
      "id": "GGL-010",
      "input": [
        "אור"
      ],
      "expected": "DIGITAL_ROOT",
      "evidence": "digital_root(207) = 9",
      "allowed": true,
      "reject": "A digital root alone does not establish an external scientific property."
    }
  ],
  "promotion_rule": {
    "required": [
      "deterministic calculation passes",
      "relationship type is named",
      "evidence is reproducible",
      "simpler mechanisms are checked",
      "PATTERN != PROOF remains explicit"
    ],
    "result": "candidate_connection"
  },
  "rarity_rule": {
    "definition": "Corpus-relative rarity describes frequency of a reproducible structure within the declared input corpus.",
    "must_not_mean": [
      "truth",
      "importance",
      "prophecy",
      "diagnosis",
      "destiny",
      "human worth"
    ],
    "boundary": "RARITY != SIGNIFICANCE"
  },
  "provenance_rule": {
    "purpose": "Bind findings to a declared corpus version, source records, and deterministic SHA-256 receipt.",
    "required": [
      "corpus id",
      "corpus version",
      "gematria system",
      "corpus digest",
      "source record ids",
      "finding payload",
      "receipt digest"
    ],
    "boundary": "RECEIPT != TRUTH"
  },
  "graph_rule": {
    "purpose": "Make reproducible anomaly relationships traversable without converting connectivity into proof or causation.",
    "receipt_backed_relations": [
      "DERIVED_FROM_CORPUS",
      "ASSERTS_ANOMALY",
      "REFERENCES_SOURCE",
      "INVOLVES_RECORD",
      "HAS_ANOMALY",
      "EXACT_COLLISION_WITH",
      "SHARES_PRIME_FACTOR_WITH",
      "LINGUISTIC_PREFIX_DELTA_TO"
    ],
    "boundaries": [
      "GRAPH != PROOF",
      "EDGE != CAUSATION",
      "CONNECTED != IDENTICAL"
    ]
  },
  "path_query_rule": {
    "purpose": "Answer bounded connection questions without inventing missing edges or converting path rank into truth.",
    "ranking": [
      "evidence floor descending",
      "hop count ascending",
      "path id lexical ascending"
    ],
    "limits": {
      "max_depth": 8,
      "max_paths": 50,
      "max_candidate_expansions": 10000
    },
    "boundaries": [
      "PATH != PROOF",
      "PATH_RANK != TRUTH",
      "EDGE != CAUSATION",
      "CONNECTED != IDENTICAL",
      "NO_PATH != NO_RELATIONSHIP"
    ]
  },
  "replication_rule": {
    "purpose": "Distinguish corpus-specific anomalies from repeated structures across declared corpora.",
    "comparison_levels": [
      "instance replication",
      "type recurrence"
    ],
    "limits": {
      "min_corpora": 2,
      "max_corpora": 16
    },
    "boundaries": [
      "REPLICATION != PROOF",
      "RECURRENCE != CAUSATION",
      "REPEATED != UNIVERSAL",
      "CORPUS_DEPENDENCE != FALSEHOOD",
      "ABSENCE != DISPROOF"
    ]
  },
  "null_model_rule": {
    "purpose": "Estimate how often an observed named anomaly reappears when the exact observed value multiset is randomly reassigned among the existing words.",
    "model": "value_permutation",
    "preserves": [
      "corpus size",
      "word set",
      "exact value multiset",
      "gematria system"
    ],
    "limits": {
      "min_simulations": 100,
      "max_simulations": 1000000
    },
    "boundaries": [
      "NULL_MODEL != REALITY",
      "EMPIRICAL_P_VALUE != TRUTH_PROBABILITY",
      "SURPRISE != SIGNIFICANCE",
      "RARE_UNDER_NULL != SUPERNATURAL",
      "PATTERN != PROOF",
      "BH_Q_VALUE != TRUTH_PROBABILITY",
      "MULTIPLE_TESTING_CORRECTION != SEMANTIC_PROOF"
    ],
    "multiple_testing": "benjamini_hochberg_fdr",
    "requires_unique_word_tokens": true,
    "report_fields": [
      "test family size",
      "raw empirical p-value",
      "Benjamini-Hochberg adjusted q-value"
    ]
  },
  "null_ensemble_rule": {
    "purpose": "Expose sensitivity of anomaly rarity to more than one declared null assumption.",
    "models": [
      "value_permutation",
      "word_length_stratified_value_permutation"
    ],
    "multiple_testing": "benjamini_hochberg_fdr_per_model",
    "default_q_threshold": 0.05,
    "statuses": [
      "NOT_UNCOMMON_UNDER_ENSEMBLE",
      "UNCOMMON_IN_MODEL_SUBSET",
      "UNCOMMON_ACROSS_ALL_MODELS"
    ],
    "boundaries": [
      "NULL_MODEL_ENSEMBLE != REALITY",
      "ROBUST_ACROSS_MODELS != TRUTH",
      "MODEL_AGREEMENT != CAUSATION",
      "Q_THRESHOLD != SEMANTIC_THRESHOLD",
      "ASSUMPTION_SENSITIVITY != FALSEHOOD"
    ]
  }
}
