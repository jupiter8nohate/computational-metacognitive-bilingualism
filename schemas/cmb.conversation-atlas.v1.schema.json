{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jupiter8nohate.github.io/computational-metacognitive-bilingualism/schemas/cmb.conversation-atlas.v1.schema.json",
  "title": "CMB Conversation Atlas v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "source",
    "naming",
    "invariants",
    "architecture",
    "concepts",
    "symbolic_sequences",
    "evidence_boundaries",
    "translation_contract"
  ],
  "properties": {
    "schema": {
      "const": "cmb.conversation-atlas.v1"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "experimental",
        "stable",
        "deprecated"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "date",
        "verbatim_transcript",
        "private_reasoning_included"
      ],
      "properties": {
        "type": {
          "const": "curated_conversation_derived_semantic_record"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "verbatim_transcript": {
          "const": false
        },
        "private_reasoning_included": {
          "const": false
        }
      }
    },
    "naming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_framework",
        "root_abbreviation",
        "canonical_public_language_name",
        "short_name",
        "implementation_layer"
      ],
      "properties": {
        "root_framework": {
          "const": "Computational Metacognitive Bilingualism"
        },
        "root_abbreviation": {
          "const": "CMB"
        },
        "canonical_public_language_name": {
          "const": "Err ⃝or⃟⃤ GLITCHOLOGY"
        },
        "short_name": {
          "const": "GLITCHOLOGY"
        },
        "implementation_layer": {
          "const": "GLITCH-8 / CMB-G8"
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "expressive_human",
        "verifiable_technical",
        "convergence",
        "terminal_evidence",
        "evidence_architecture"
      ],
      "properties": {
        "model": {
          "const": "dual_pillar"
        },
        "expressive_human": {
          "$ref": "#/$defs/pillar"
        },
        "verifiable_technical": {
          "$ref": "#/$defs/pillar"
        },
        "convergence": {
          "const": "Creative Cognitive Signature"
        },
        "terminal_evidence": {
          "const": "Authorship Trail"
        },
        "evidence_architecture": {
          "const": "Creative Proof-of-Origin"
        }
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/concept"
      }
    },
    "symbolic_sequences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/symbolicSequence"
      }
    },
    "evidence_boundaries": {
      "type": "object"
    },
    "translation_contract": {
      "type": "object"
    }
  },
  "$defs": {
    "pillar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "components"
      ],
      "properties": {
        "root": {
          "type": "string"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "concept": {
      "type": "object",
      "required": [
        "id",
        "name",
        "definition"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "symbolicSequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "expression",
        "semantic_flow",
        "plain_language",
        "invariants"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "expression": {
          "type": "string"
        },
        "semantic_flow": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "plain_language": {
          "type": "string"
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    }
  }
}
