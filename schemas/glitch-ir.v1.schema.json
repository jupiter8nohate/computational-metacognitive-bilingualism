{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmbprotocol.org/schemas/glitch-ir.v1.schema.json",
  "title": "GLITCH-IR v1 canonical result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "vector",
    "protocol",
    "operator",
    "state",
    "verdict",
    "evidence",
    "source",
    "witness",
    "human_review"
  ],
  "properties": {
    "contract": {"const": "glitch-ir/1"},
    "vector": {"type": "string", "pattern": "^GLT-8101-V[0-9]{3}$"},
    "protocol": {"const": "GLT-8101"},
    "operator": {"type": "string", "minLength": 1},
    "state": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "verdict": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "evidence": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "source": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "witness": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "human_review": {"type": "boolean"}
  }
}
