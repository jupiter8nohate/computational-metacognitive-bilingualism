{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jupiter8nohate.github.io/computational-metacognitive-bilingualism/schemas/gematria-glitch.finding.v1.schema.json",
  "title": "GEMATRIA-GLITCH-1 Finding",
  "type": "object",
  "required": [
    "type",
    "words",
    "values",
    "evidence",
    "confidence",
    "boundary",
    "glitch_glyph",
    "support_count",
    "support_basis",
    "rarity_score"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "EXACT_COLLISION",
        "PALINDROME",
        "PERFECT_SQUARE",
        "TRIANGULAR_NUMBER",
        "POWER_OF_TWO",
        "PRIME_VALUE",
        "DIGITAL_ROOT",
        "SHARED_PRIME_FACTOR",
        "LINGUISTIC_PREFIX_DELTA"
      ]
    },
    "words": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "const": "DETERMINISTIC_ARITHMETIC"
    },
    "boundary": {
      "const": "PATTERN != PROOF"
    },
    "glitch_glyph": {
      "type": "string",
      "minLength": 1
    },
    "support_count": {
      "type": "integer",
      "minimum": 1
    },
    "support_basis": {
      "type": "integer",
      "minimum": 1
    },
    "rarity_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "allOf": [
    {
      "properties": {
        "support_count": {
          "type": "integer"
        },
        "support_basis": {
          "type": "integer"
        }
      }
    }
  ],
  "additionalProperties": false
}
