  "lessons": {
    "PREDICT": {
      "question": "What evidence produced this prediction, classification, profile, or score?",
      "check": "Look for source data, uncertainty, false-positive rates, appeal rights, and whether a human independently verified the inference.",
      "invariant": "PATTERN != PROOF"
    },
    "GENERATE": {
      "question": "Can the generated text, image, audio, or claim be traced back to an authentic source?",
      "check": "Check provenance, direct quotations, original media, disclosure, and whether synthetic output is being mistaken for evidence.",
      "invariant": "SIMULATION != SOURCE"
    },
    "ACT": {
      "question": "Who authorized the machine-influenced action, and can a human stop or reverse it?",
      "check": "Look for scoped permission, audit logs, human override, reversibility, and consequences if the system is wrong.",
      "invariant": "CAPABILITY != AUTHORITY"
    }
  },
  "epistemic_boundaries": [
    "PATTERN != PROOF",
    "PROFILE != PERSON",
    "MODEL != MIND",
    "PREDICTION != DESTINY",
    "HEADLINE_SIMILARITY != FACT_CORROBORATION",
    "DISCREPANCY_FLAG != CONTRADICTION_PROOF",
    "EMERGING_TERM != NEW_TECHNOLOGY_PROOF",
    "NEWS_REPORT != VERIFIED_FACT",
    "CMB_INTERPRETATION != SOURCE_ENDORSEMENT",
    "HUMAN_AGENCY > MACHINE_AUTHORITY"
  ]
