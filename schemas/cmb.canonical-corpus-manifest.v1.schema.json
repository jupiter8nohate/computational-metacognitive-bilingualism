{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/jupiter8nohate/computational-metacognitive-bilingualism/blob/main/schemas/cmb.canonical-corpus-manifest.v1.schema.json",
  "title":"CMB Canonical Corpus Manifest v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","framework","format","record_schema","corpus_file","record_count","sha256","canonical_repository","license_reference","boundaries"],
  "properties":{
    "schema_version":{"const":"cmb.canonical-corpus-manifest.v1"},
    "framework":{"const":"Computational Metacognitive Bilingualism"},
    "format":{"const":"jsonl"},
    "record_schema":{"const":"schemas/cmb.canonical-corpus-record.v1.schema.json"},
    "corpus_file":{"const":"datasets/cmb-canonical-corpus/corpus.jsonl"},
    "record_count":{"type":"integer","minimum":1},
    "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "canonical_repository":{"type":"string","format":"uri"},
    "license_reference":{"const":"CONTENT_LICENSE.md"},
    "boundaries":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
  }
}
