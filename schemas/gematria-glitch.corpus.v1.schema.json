{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jupiter8nohate.github.io/computational-metacognitive-bilingualism/schemas/gematria-glitch.corpus.v1.schema.json",
  "title": "GEMATRIA-GLITCH-1 Corpus",
  "type": "object",
  "required": [
    "schema_version",
    "corpus_id",
    "version",
    "gematria_system",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "gematria-glitch.corpus.v1"
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "gematria_system": {
      "const": "mispar_hechrachi"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "word",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "word": {
            "type": "string",
            "minLength": 1
          },
          "gloss": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "reference"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
