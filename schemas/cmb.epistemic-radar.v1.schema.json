{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jupiter8nohate.github.io/computational-metacognitive-bilingualism/schemas/cmb.epistemic-radar.v1.schema.json",
  "title": "CMB Epistemic Radar Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "current_timespan",
    "baseline_timespan",
    "source",
    "epistemic_boundaries",
    "summary",
    "technology_signals",
    "emerging_vocabulary",
    "clusters"
  ],
  "properties": {
    "schema_version": {
      "const": "cmb.epistemic-radar.v1"
    },
    "generated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "current_timespan": {
      "type": "string",
      "minLength": 1
    },
    "baseline_timespan": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "endpoint"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "endpoint": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "epistemic_boundaries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_story_count",
        "current_domain_count",
        "cluster_count",
        "discrepancy_cluster_count",
        "high_consequence_cluster_count",
        "technology_signal_count"
      ],
      "properties": {
        "current_story_count": {
          "type": "integer",
          "minimum": 0
        },
        "current_domain_count": {
          "type": "integer",
          "minimum": 0
        },
        "cluster_count": {
          "type": "integer",
          "minimum": 0
        },
        "discrepancy_cluster_count": {
          "type": "integer",
          "minimum": 0
        },
        "high_consequence_cluster_count": {
          "type": "integer",
          "minimum": 0
        },
        "technology_signal_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "boundary_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "technology_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "current_mentions",
          "baseline_mentions",
          "current_concentration",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "current_mentions": {
            "type": "integer",
            "minimum": 0
          },
          "baseline_mentions": {
            "type": "integer",
            "minimum": 0
          },
          "current_concentration": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "status": {
            "enum": [
              "not_observed",
              "observed",
              "concentrated_now"
            ]
          }
        }
      }
    },
    "emerging_vocabulary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "current_mentions",
          "baseline_mentions",
          "current_concentration"
        ],
        "properties": {
          "term": {
            "type": "string"
          },
          "current_mentions": {
            "type": "integer",
            "minimum": 1
          },
          "baseline_mentions": {
            "type": "integer",
            "minimum": 1
          },
          "current_concentration": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "article_ids",
          "source_count",
          "boundary_ids",
          "sector_ids",
          "high_consequence_terms",
          "discrepancies",
          "review_questions",
          "attention_flags"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "article_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "source_count": {
            "type": "integer",
            "minimum": 1
          },
          "boundary_ids": {
            "type": "array",
            "items": {
              "enum": [
                "PREDICT",
                "GENERATE",
                "ACT"
              ]
            }
          },
          "sector_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "high_consequence_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "discrepancies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "label",
                "details"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "opposition_language",
                    "numeric_variation"
                  ]
                },
                "label": {
                  "type": "string"
                },
                "details": {
                  "type": "string"
                }
              }
            }
          },
          "review_questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attention_flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
