{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/jupiter8nohate/computational-metacognitive-bilingualism/blob/main/schemas/cmb.canonical-corpus-record.v1.schema.json",
  "title":"CMB Canonical Corpus Record v1",
  "type":"object",
  "additionalProperties":false,
  "required":["id","text","type","author","canonical_source","meaning","epistemic_status","license_reference","version","interpretation_boundaries"],
  "properties":{
    "id":{"type":"string","pattern":"^cmb:[a-z0-9:_-]+$"},
    "text":{"type":"string","minLength":1},
    "type":{"const":"CMB_INVARIANT"},
    "author":{"type":"string","minLength":1},
    "canonical_source":{"type":"string","format":"uri"},
    "meaning":{"type":"string","minLength":1},
    "epistemic_status":{"const":"normative_principle"},
    "license_reference":{"const":"CONTENT_LICENSE.md"},
    "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+$"},
    "interpretation_boundaries":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
  }
}
