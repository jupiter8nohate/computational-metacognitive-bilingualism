{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jupiter8nohate/computational-metacognitive-bilingualism/blob/main/schemas/cmb.library.catalog.v1.schema.json",
  "title": "CMB Digital Library Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "framework",
    "declared_originator",
    "purpose",
    "invariants",
    "interpretation_policy",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "cmb.library.catalog.v1"
    },
    "framework": {
      "const": "Computational Metacognitive Bilingualism"
    },
    "declared_originator": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "interpretation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_is_identity",
        "classification_is_truth",
        "uncertainty_is_allowed",
        "human_self_definition_has_priority",
        "provenance_note"
      ],
      "properties": {
        "catalog_is_identity": {
          "const": false
        },
        "classification_is_truth": {
          "const": false
        },
        "uncertainty_is_allowed": {
          "const": true
        },
        "human_self_definition_has_priority": {
          "const": true
        },
        "provenance_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "path",
          "format",
          "kind",
          "status",
          "provenance_scope",
          "human_readable",
          "machine_indexable",
          "concepts",
          "declared_meaning"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["canonical", "derived", "planned", "open"]
          },
          "provenance_scope": {
            "enum": ["canonical_public_artifact", "repository_artifact"]
          },
          "human_readable": {
            "type": "boolean"
          },
          "machine_indexable": {
            "type": "boolean"
          },
          "concepts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "declared_meaning": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
