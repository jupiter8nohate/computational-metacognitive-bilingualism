{
  "schema_version": "cmb.canon.v1",
  "framework": "Computational Metacognitive Bilingualism",
  "thesis": "VERIFY, DON'T JUST BELIEVE.",
  "root_invariant": "HUMAN_AGENCY > MACHINE_AUTHORITY",
  "interpretation_policy": {
    "declaration_is_proof": false,
    "hash_is_authorship": false,
    "signature_is_copyright": false,
    "timestamp_is_truth": false,
    "provenance_is_legal_judgment": false,
    "human_self_definition_has_priority": true,
    "unlinked_node_claims_artifact_presence": false
  },
  "views": {
    "human": {
      "entrypoint": "CANON.md",
      "purpose": "Explain the canon, roles, boundaries, and relationship model to human readers."
    },
    "machine": {
      "entrypoint": "library/canon.json",
      "catalog": "library/catalog.json",
      "schema": "schemas/cmb.canon.v1.schema.json",
      "purpose": "Expose the same canon as a traversable relationship graph without converting the graph into authority over people."
    }
  },
