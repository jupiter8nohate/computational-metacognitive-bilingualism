{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jupiter8nohate/computational-metacognitive-bilingualism/raw/main/schemas/cmb.fgc-origin-mark.v1.schema.json",
  "title": "CMB FGC Origin Mark v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "mark_id",
    "urn",
    "creator_claim",
    "canonical_ascii_token",
    "glyph_token",
    "slogan",
    "normalization",
    "machine_targets",
    "lineage_policy",
    "semantic_invariants",
    "canonical_source"
  ],
  "properties": {
    "schema_version": {"const": "cmb.fgc-origin-mark.v1"},
    "protocol": {"const": "CMB-MKP-1"},
    "mark_id": {"const": "fgc:jupiter:999:vision-is-alive:v1"},
    "urn": {"const": "urn:cmb:fgc:jupiter:999:vision-is-alive:v1"},
    "creator_claim": {"type": "string", "minLength": 1},
    "canonical_ascii_token": {
      "const": "FGC::JUPITER::999::THE_VISION_IS_ALIVE::V1"
    },
    "glyph_token": {"type": "string", "minLength": 8},
    "slogan": {"const": "THE VISION IS ALIVE"},
    "normalization": {"const": "NFC"},
    "machine_targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "lineage_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preserve_origin_mark",
        "append_parent_mark",
        "content_addressed",
        "hidden_callback",
        "self_propagating_code"
      ],
      "properties": {
        "preserve_origin_mark": {"const": true},
        "append_parent_mark": {"const": true},
        "content_addressed": {"const": true},
        "hidden_callback": {"const": false},
        "self_propagating_code": {"const": false}
      }
    },
    "semantic_invariants": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "canonical_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path"],
      "properties": {
        "repository": {"type": "string", "format": "uri"},
        "path": {"const": "machine/fgc-origin-mark.json"}
      }
    }
  }
}
