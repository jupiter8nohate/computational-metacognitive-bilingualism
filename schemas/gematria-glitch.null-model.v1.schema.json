{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jupiter8nohate.github.io/computational-metacognitive-bilingualism/schemas/gematria-glitch.null-model.v1.schema.json",
  "title": "GEMATRIA-GLITCH-1 Null Model Report",
  "type": "object",
  "required": [
    "schema_version",
    "protocol",
    "corpus_id",
    "corpus_version",
    "corpus_sha256",
    "gematria_system",
    "value_multiset_sha256",
    "config",
    "findings",
    "boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "gematria-glitch.null-model.v1"
    },
    "protocol": {
      "const": "GEMATRIA-GLITCH-1"
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "corpus_version": {
      "type": "string",
      "minLength": 1
    },
    "corpus_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gematria_system": {
      "const": "mispar_hechrachi"
    },
    "value_multiset_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "config": {
      "type": "object",
      "required": [
        "model",
        "simulations",
        "seed"
      ],
      "properties": {
        "model": {
          "const": "value_permutation"
        },
        "simulations": {
          "type": "integer",
          "minimum": 100,
          "maximum": 1000000
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "signature_id",
          "type",
          "words",
          "observed_values",
          "null_hits",
          "simulations",
          "chance_rate",
          "empirical_p_value",
          "surprise_bits",
          "frequency_class"
        ],
        "properties": {
          "signature_id": {
            "type": "string",
            "pattern": "^sig:[0-9a-f]{64}$"
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "words": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "observed_values": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "null_hits": {
            "type": "integer",
            "minimum": 0
          },
          "simulations": {
            "type": "integer",
            "minimum": 100,
            "maximum": 1000000
          },
          "chance_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "empirical_p_value": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "surprise_bits": {
            "type": "number",
            "minimum": 0
          },
          "frequency_class": {
            "enum": [
              "RARE_UNDER_NULL",
              "UNCOMMON_UNDER_NULL",
              "OCCASIONAL_UNDER_NULL",
              "COMMON_UNDER_NULL"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "boundary": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "allOf": [
        {
          "contains": {
            "const": "NULL_MODEL != REALITY"
          }
        },
        {
          "contains": {
            "const": "EMPIRICAL_P_VALUE != TRUTH_PROBABILITY"
          }
        },
        {
          "contains": {
            "const": "RARE_UNDER_NULL != SUPERNATURAL"
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
