{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jupiter8nohate/computational-metacognitive-bilingualism/schemas/cmb.authorization.v1.schema.json",
  "title": "CMB Scoped Authorization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "project",
    "policy_digest",
    "subject_digest",
    "authorized_by",
    "issued_at",
    "expires_at",
    "nonce",
    "controls",
    "signature"
  ],
  "properties": {
    "schema": {"const": "cmb.authorization.v1"},
    "operation": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
    "subject_digest": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
    "authorized_by": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "nonce": {"type": "string", "minLength": 16},
    "controls": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "signature": {"type": "string", "minLength": 1}
  }
}
