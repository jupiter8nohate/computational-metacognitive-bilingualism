{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jupiter8nohate/cmb-google-semantic-bridge/blob/main/schemas/cmb-gsb.artifact.v1.schema.json",
  "title": "CMB Google Semantic Bridge Artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "url",
    "title",
    "description",
    "author",
    "date_published",
    "date_modified",
    "language",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "cmb-gsb.artifact.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "date_published": {
      "type": "string",
      "format": "date-time"
    },
    "date_modified": {
      "type": "string",
      "format": "date-time"
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "body": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_authored", "human_authority"],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "repository": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "human_authored": {
          "const": true
        },
        "human_authority": {
          "const": "HUMAN_FINAL"
        }
      }
    }
  }
}
