{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jupiter8nohate/computational-metacognitive-bilingualism/blob/main/schemas/cmb.recovery-map.v1.schema.json",
  "title": "CMB Recovery Map v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","framework","canonical_repository","canonical_site","claims","integrity_layers","archives","recovery_order","boundaries"],
  "properties": {
    "schema_version": {"const": "cmb.recovery-map.v1"},
    "framework": {"const": "Computational Metacognitive Bilingualism"},
    "canonical_repository": {"type":"string","format":"uri"},
    "canonical_site": {"type":"string","format":"uri"},
    "claims": {
      "type":"object",
      "additionalProperties": false,
      "required":["permanence_guaranteed","availability_guaranteed","blockchain_used","dna_storage_deployed"],
      "properties":{
        "permanence_guaranteed":{"const":false},
        "availability_guaranteed":{"const":false},
        "blockchain_used":{"type":"boolean"},
        "dna_storage_deployed":{"const":false}
      }
    },
    "integrity_layers": {
      "type":"array","minItems":1,
      "items":{"$ref":"#/$defs/layer"}
    },
    "archives": {
      "type":"array","minItems":1,
      "items":{"$ref":"#/$defs/layer"}
    },
    "recovery_order": {
      "type":"array","minItems":1,"uniqueItems":true,
      "items":{"type":"string","minLength":1}
    },
    "boundaries": {
      "type":"array","minItems":1,"uniqueItems":true,
      "items":{"type":"string","minLength":1}
    }
  },
  "$defs": {
    "layer": {
      "type":"object",
      "additionalProperties":false,
      "required":["id","status","evidence","note"],
      "properties":{
        "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9_-]*$"},
        "status":{"enum":["implemented","planned","not_configured","research_only","external"]},
        "evidence":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "note":{"type":"string","minLength":1}
      }
    }
  }
}
