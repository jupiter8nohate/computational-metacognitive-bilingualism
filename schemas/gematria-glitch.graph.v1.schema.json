{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jupiter8nohate.github.io/computational-metacognitive-bilingualism/schemas/gematria-glitch.graph.v1.schema.json",
  "title": "GEMATRIA-GLITCH-1 Anomaly Knowledge Graph",
  "type": "object",
  "required": [
    "payload",
    "graph_sha256"
  ],
  "properties": {
    "payload": {
      "type": "object",
      "required": [
        "schema_version",
        "protocol",
        "corpus_id",
        "corpus_version",
        "corpus_sha256",
        "gematria_system",
        "nodes",
        "edges",
        "boundary"
      ],
      "properties": {
        "schema_version": {
          "const": "gematria-glitch.graph.v1"
        },
        "protocol": {
          "const": "GEMATRIA-GLITCH-1"
        },
        "corpus_id": {
          "type": "string",
          "minLength": 1
        },
        "corpus_version": {
          "type": "string",
          "minLength": 1
        },
        "corpus_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "gematria_system": {
          "const": "mispar_hechrachi"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "CORPUS",
                  "RECORD",
                  "SOURCE",
                  "VALUE",
                  "PRIME_FACTOR",
                  "RECEIPT",
                  "ANOMALY_TYPE"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "word": {
                "type": "string"
              },
              "gloss": {
                "type": "string"
              },
              "value": {
                "type": "integer",
                "minimum": 1
              },
              "factor": {
                "type": "integer",
                "minimum": 2
              },
              "anomaly_type": {
                "type": "string"
              },
              "receipt_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "source_kind": {
                "type": "string"
              },
              "source_reference": {
                "type": "string"
              },
              "source_url": {
                "type": "string",
                "format": "uri"
              }
            },
            "additionalProperties": false
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "from",
              "relation",
              "to"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^edge:[0-9a-f]{64}$"
              },
              "from": {
                "type": "string",
                "minLength": 1
              },
              "relation": {
                "enum": [
                  "CONTAINS_RECORD",
                  "SOURCED_BY",
                  "HAS_GEMATRIA_VALUE",
                  "HAS_PRIME_FACTOR",
                  "DERIVED_FROM_CORPUS",
                  "ASSERTS_ANOMALY",
                  "REFERENCES_SOURCE",
                  "INVOLVES_RECORD",
                  "HAS_ANOMALY",
                  "EXACT_COLLISION_WITH",
                  "SHARES_PRIME_FACTOR_WITH",
                  "LINGUISTIC_PREFIX_DELTA_TO"
                ]
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "receipt_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "evidence": {
                "type": "string"
              },
              "numeric_value": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "boundary": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "allOf": [
            {
              "contains": {
                "const": "GRAPH != PROOF"
              }
            },
            {
              "contains": {
                "const": "EDGE != CAUSATION"
              }
            },
            {
              "contains": {
                "const": "CONNECTED != IDENTICAL"
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "graph_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
