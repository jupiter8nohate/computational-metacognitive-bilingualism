{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jupiter8nohate.github.io/computational-metacognitive-bilingualism/schemas/cmb.conversation-atlas.v1.schema.json",
  "title": "CMB Conversation Atlas v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "source",
    "naming",
    "invariants",
    "architecture",
    "concepts",
    "symbolic_sequences",
    "evidence_boundaries",
    "translation_contract"
  ],
  "properties": {
    "schema": {
      "const": "cmb.conversation-atlas.v1"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "experimental",
        "stable",
        "deprecated"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "date",
        "verbatim_transcript",
        "private_reasoning_included"
      ],
      "properties": {
        "type": {
          "const": "curated_conversation_derived_semantic_record"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "verbatim_transcript": {
          "const": false
        },
        "private_reasoning_included": {
          "const": false
        }
      }
    },
    "naming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_framework",
        "root_abbreviation",
        "canonical_public_language_name",
        "short_name",
        "implementation_layer"
      ],
      "properties": {
        "root_framework": {
          "const": "Computational Metacognitive Bilingualism"
        },
        "root_abbreviation": {
          "const": "CMB"
        },
        "canonical_public_language_name": {
          "const": "Err ⃝or⃟⃤ GLITCHOLOGY"
        },
        "short_name": {
          "const": "GLITCHOLOGY"
        },
        "implementation_layer": {
          "const": "GLITCH-8 / CMB-G8"
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "allOf": [
        {
          "contains": {
            "const": "PATTERN != PROOF"
          }
        },
        {
          "contains": {
            "const": "PROFILE != PERSON"
          }
        },
        {
          "contains": {
            "const": "MODEL != MIND"
          }
        },
        {
          "contains": {
            "const": "PREDICTION != DESTINY"
          }
        },
        {
          "contains": {
            "const": "DIFFERENCE != DEFECT"
          }
        },
        {
          "contains": {
            "const": "CAPABILITY != AUTHORITY"
          }
        },
        {
          "contains": {
            "const": "MACHINE_CAN_READ != MACHINE_CAN_DEFINE"
          }
        },
        {
          "contains": {
            "const": "HUMAN_AGENCY > MACHINE_AUTHORITY"
          }
        }
      ]
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "expressive_human",
        "verifiable_technical",
        "convergence",
        "terminal_evidence",
        "evidence_architecture"
      ],
      "properties": {
        "model": {
          "const": "dual_pillar"
        },
        "expressive_human": {
          "allOf": [
            {
              "$ref": "#/$defs/pillar"
            },
            {
              "properties": {
                "root": {
                  "const": "Err ⃝or⃟⃤ GLITCHOLOGY"
                }
              }
            }
          ]
        },
        "verifiable_technical": {
          "allOf": [
            {
              "$ref": "#/$defs/pillar"
            },
            {
              "properties": {
                "root": {
                  "const": "Provenance"
                }
              }
            }
          ]
        },
        "convergence": {
          "const": "Creative Cognitive Signature"
        },
        "terminal_evidence": {
          "const": "Authorship Trail"
        },
        "evidence_architecture": {
          "const": "Creative Proof-of-Origin"
        }
      }
    },
    "concepts": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/concept"
      }
    },
    "symbolic_sequences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/symbolicSequence"
      }
    },
    "evidence_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash",
        "signature",
        "timestamp",
        "git_history",
        "prohibited_equivalences"
      ],
      "properties": {
        "hash": {
          "const": "byte_integrity_evidence"
        },
        "signature": {
          "const": "evidence_of_key_control_over_a_signed_digest"
        },
        "timestamp": {
          "const": "evidence_of_recorded_existence_by_a_time"
        },
        "git_history": {
          "const": "versioned_tamper_evident_history"
        },
        "prohibited_equivalences": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "allOf": [
            {
              "contains": {
                "const": "HASH == AUTHORSHIP"
              }
            },
            {
              "contains": {
                "const": "SIGNATURE == ORIGINALITY"
              }
            },
            {
              "contains": {
                "const": "TIMESTAMP == THOUGHT_CREATION_TIME"
              }
            },
            {
              "contains": {
                "const": "GIT_HISTORY == UNIVERSAL_IMMUTABILITY"
              }
            },
            {
              "contains": {
                "const": "CRYPTOGRAPHY == PROOF_OF_CONSCIOUSNESS"
              }
            }
          ]
        }
      }
    },
    "translation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "syntax_may_change",
        "semantics_must_not_drift",
        "required_boundaries"
      ],
      "properties": {
        "syntax_may_change": {
          "const": true
        },
        "semantics_must_not_drift": {
          "const": true
        },
        "required_boundaries": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "allOf": [
            {
              "contains": {
                "const": "DECLARED_POLICY != TECHNICAL_ENFORCEMENT"
              }
            },
            {
              "contains": {
                "const": "CRYPTOGRAPHIC_INTEGRITY != AUTHORSHIP_BY_ITSELF"
              }
            },
            {
              "contains": {
                "const": "PROVENANCE != CONSCIOUSNESS"
              }
            },
            {
              "contains": {
                "const": "CREATIVE_SIGNATURE != COMPLETE_PERSON"
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "pillar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "components"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "definition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^cmb:concept:[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "exclusions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "symbolicSequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "expression",
        "semantic_flow",
        "plain_language",
        "invariants"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "semantic_flow": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "plain_language": {
          "type": "string",
          "minLength": 1
        },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
