{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jupiter8nohate.github.io/computational-metacognitive-bilingualism/schemas/cmb.capability-credential.v1.schema.json",
  "title": "CMB Capability Credential v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "protocol",
    "credential_id",
    "issuer",
    "subject",
    "authority",
    "issued_at",
    "expires_at",
    "nonce",
    "parent_credential_digest",
    "interoperability",
    "proof"
  ],
  "properties": {
    "schema": {"const": "cmb.capability-credential.v1"},
    "protocol": {"const": "CMB-CAP-1"},
    "credential_id": {
      "type": "string",
      "pattern": "^urn:cmb:cap:[0-9a-f]{64}$"
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"const": "human"},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"const": "agent"},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "authority": {
      "type": "object",
      "required": [
        "schema",
        "protocol",
        "issuer",
        "subject",
        "capabilities",
        "scopes",
        "purpose",
        "expires_at",
        "required_evidence",
        "event_handlers",
        "return_receipt",
        "delegable",
        "invariants",
        "digest"
      ]
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "nonce": {"type": "string", "minLength": 16},
    "parent_credential_digest": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      ]
    },
    "interoperability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mcp_extension", "a2a_extension_uri", "w3c_vc_2_0"],
      "properties": {
        "mcp_extension": {"const": "io.cmb.capability/v1"},
        "a2a_extension_uri": {"type": "string", "format": "uri"},
        "w3c_vc_2_0": {
          "const": "projection_available_not_data_integrity_conformant"
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "created",
        "verification_method",
        "public_key_b64",
        "signature"
      ],
      "properties": {
        "type": {"const": "CMBEd25519SignatureV1"},
        "created": {"type": "string", "format": "date-time"},
        "verification_method": {
          "type": "string",
          "pattern": "^cmb:key:sha256:[0-9a-f]{64}$"
        },
        "public_key_b64": {"type": "string", "minLength": 40},
        "signature": {"type": "string", "minLength": 80}
      }
    }
  }
}
