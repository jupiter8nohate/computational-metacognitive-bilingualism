{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jupiter8nohate.github.io/computational-metacognitive-bilingualism/schemas/glitch8.glyph-registry.v1.schema.json",
  "title": "GLITCH-8 Glyph Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "language",
    "language_version",
    "updated_at",
    "author",
    "principles",
    "categories",
    "glyphs"
  ],
  "properties": {
    "schema_version": {
      "const": "glitch8.glyph-registry.v1"
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "language_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "principles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "glyphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/glyph"
      }
    }
  },
  "$defs": {
    "glyph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "glyph",
        "aliases",
        "name",
        "categories",
        "semantic_key",
        "version",
        "status",
        "definition",
        "cmb_invariant",
        "human_semantics",
        "machine_semantics",
        "runtime_behavior",
        "example",
        "created_at",
        "author"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "glyph": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "semantic_key": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "status": {
          "enum": [
            "experimental",
            "proposed",
            "canonical",
            "deprecated",
            "retired"
          ]
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "cmb_invariant": {
          "type": "string",
          "minLength": 1
        },
        "human_semantics": {
          "type": "string",
          "minLength": 1
        },
        "machine_semantics": {
          "type": "string",
          "minLength": 1
        },
        "runtime_behavior": {
          "type": "object",
          "minProperties": 1
        },
        "example": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date"
        },
        "author": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
