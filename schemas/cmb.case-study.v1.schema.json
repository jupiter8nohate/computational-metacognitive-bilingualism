{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jupiter8nohate/computational-metacognitive-bilingualism/blob/main/schemas/cmb.case-study.v1.schema.json",
  "title": "CMB Research Case Study v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "observed_at",
    "logged_at",
    "platform",
    "case_type",
    "subject",
    "human_report_path",
    "summary",
    "evidence",
    "claims",
    "verification",
    "interpretation_boundaries",
    "revision_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "cmb.case-study.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date"
    },
    "logged_at": {
      "type": "string",
      "format": "date"
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "case_type": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_name",
        "framework"
      ],
      "properties": {
        "declared_name": {
          "type": "string",
          "minLength": 1
        },
        "framework": {
          "const": "Computational Metacognitive Bilingualism (CMB)"
        }
      }
    },
    "human_report_path": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "source_status",
          "public_copy",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "source_status": {
            "enum": [
              "user_supplied",
              "public_source",
              "repository_source",
              "platform_documentation"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "dimensions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "width",
              "height"
            ],
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "public_copy": {
            "type": "boolean"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "status",
          "evidence_boundary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "supported",
              "supported_in_broad_form",
              "not_established",
              "not_verified",
              "unsupported_by_available_evidence"
            ]
          },
          "evidence_boundary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "performed_at",
        "methods",
        "sources",
        "limitations"
      ],
      "properties": {
        "performed_at": {
          "type": "string",
          "format": "date"
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "url",
              "role"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "role": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "interpretation_boundaries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "revision_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "open_to_revision",
        "triggers"
      ],
      "properties": {
        "open_to_revision": {
          "const": true
        },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
