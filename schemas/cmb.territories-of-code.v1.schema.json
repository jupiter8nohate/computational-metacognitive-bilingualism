{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jupiter8nohate/computational-metacognitive-bilingualism/blob/main/schemas/cmb.territories-of-code.v1.schema.json",
  "title": "CMB Territories of Code Research Map v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "framework",
    "title",
    "status",
    "historical_claim",
    "historical_claim_boundary",
    "invariants",
    "priority_order",
    "territories",
    "research_gate"
  ],
  "properties": {
    "schema_version": {
      "const": "cmb.territories-of-code.v1"
    },
    "framework": {
      "const": "Computational Metacognitive Bilingualism (CMB)"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "research_map"
    },
    "historical_claim": {
      "const": "candidate_and_emerging_territories_only"
    },
    "historical_claim_boundary": {
      "type": "string",
      "minLength": 1
    },
    "invariants": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "priority_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "territories": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "domain",
          "horizon",
          "maturity",
          "cmb_fit",
          "research_question",
          "prototype",
          "evidence_needed",
          "safeguards",
          "boundaries"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "enum": [
              "law",
              "biology",
              "cognition",
              "culture",
              "matter",
              "governance"
            ]
          },
          "horizon": {
            "enum": [
              "near_term",
              "mid_term",
              "long_term"
            ]
          },
          "maturity": {
            "enum": [
              "research_candidate",
              "prototype_ready"
            ]
          },
          "cmb_fit": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "research_question": {
            "type": "string",
            "minLength": 1
          },
          "prototype": {
            "type": "string",
            "minLength": 1
          },
          "evidence_needed": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "safeguards": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "boundaries": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "research_gate": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
