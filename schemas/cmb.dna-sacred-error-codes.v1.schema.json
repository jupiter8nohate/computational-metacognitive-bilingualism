{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jupiter8nohate.github.io/computational-metacognitive-bilingualism/schemas/cmb.dna-sacred-error-codes.v1.schema.json",
  "title": "CMB D.N.A. Bible Sacred Error Codes v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_version",
    "framework",
    "work",
    "author",
    "updated_at",
    "status",
    "boundaries",
    "translation_conformance",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": "cmb.dna-sacred-error-codes.v1"
    },
    "registry_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "framework": {
      "const": "Computational Metacognitive Bilingualism"
    },
    "work": {
      "const": "D.N.A. BIBLE://SACRED_ERROR_CODES"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "enum": [
        "experimental",
        "proposed",
        "canonical",
        "deprecated",
        "retired"
      ]
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/error"
      }
    },
    "translation_conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "set",
        "entry_ids",
        "required_fields"
      ],
      "properties": {
        "set": {
          "const": "sacred_translation_v1"
        },
        "entry_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SEC-\\d{4}$"
          }
        },
        "required_fields": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "plain_language",
              "principle",
              "epistemic_type",
              "machine_permissions",
              "machine_boundaries"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "book",
        "chapter",
        "verses",
        "mode"
      ],
      "properties": {
        "book": {
          "type": "string",
          "minLength": 1
        },
        "chapter": {
          "type": "integer",
          "minimum": 1
        },
        "verses": {
          "type": "string",
          "pattern": "^\\d+(?:-\\d+)?$"
        },
        "mode": {
          "enum": [
            "interpretive_paraphrase",
            "narrative_interpretation"
          ]
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "source",
        "theme",
        "trigger",
        "recovery",
        "invariants",
        "interpretation",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SEC-\\d{4}$"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "theme": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "recovery": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "interpretation": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "experimental",
            "proposed",
            "canonical",
            "deprecated",
            "retired"
          ]
        },
        "plain_language": {
          "type": "string",
          "minLength": 1
        },
        "principle": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "epistemic_type": {
          "enum": [
            "theological_interpretation",
            "philosophical_principle",
            "code_poetry",
            "textual_reference"
          ]
        },
        "machine_permissions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "translate",
              "explain",
              "compare",
              "summarize",
              "trace_source"
            ]
          }
        },
        "machine_boundaries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          }
        }
      }
    }
  }
}
