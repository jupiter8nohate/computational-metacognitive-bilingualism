{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jupiter8nohate/computational-metacognitive-bilingualism/blob/main/schemas/cmb.creator-provenance.v1.schema.json",
  "title": "CMB Creator Provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "framework",
    "creator",
    "purpose",
    "evidence_model",
    "historical_genealogical_provenance",
    "intellectual_lineage",
    "symbolic_lineage",
    "symbolic_equations",
    "epistemic_boundaries",
    "privacy_policy",
    "third_party_notice"
  ],
  "properties": {
    "schema_version": {
      "const": "cmb.creator-provenance.v1"
    },
    "framework": {
      "const": "Computational Metacognitive Bilingualism"
    },
    "creator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_name",
        "publishing_names",
        "role"
      ],
      "properties": {
        "declared_name": {
          "type": "string",
          "minLength": 1
        },
        "publishing_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "evidence_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "genealogy_source",
        "authorship_declaration",
        "cryptographic_provenance"
      ],
      "properties": {
        "genealogy_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_type",
            "source_platform",
            "status",
            "independent_verification",
            "public_source_material_in_repository",
            "living_relative_details_in_public_registry",
            "claim_scope"
          ],
          "properties": {
            "source_type": {
              "const": "creator_supplied_family_tree"
            },
            "source_platform": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "const": "creator_documented_not_independently_verified"
            },
            "independent_verification": {
              "const": false
            },
            "public_source_material_in_repository": {
              "const": false
            },
            "living_relative_details_in_public_registry": {
              "const": false
            },
            "claim_scope": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "authorship_declaration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "independent_priority_verification",
            "claim_scope"
          ],
          "properties": {
            "status": {
              "const": "declared_by_project"
            },
            "independent_priority_verification": {
              "const": false
            },
            "claim_scope": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "cryptographic_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "claim_scope"
          ],
          "properties": {
            "claim_scope": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "historical_genealogical_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "public_summary",
        "allowed_inferences",
        "forbidden_inferences"
      ],
      "properties": {
        "classification": {
          "const": "historical_context"
        },
        "public_summary": {
          "type": "string",
          "minLength": 1
        },
        "allowed_inferences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_inferences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "intellectual_lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "classification"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "const": "declared_intellectual_influence"
          }
        }
      }
    },
    "symbolic_lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "classification",
          "declared_role"
        ],
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "religious_symbolic_reference",
              "mythological_symbolic_reference",
              "third_party_cultural_reference",
              "third_party_game_glitch_reference",
              "author_defined_symbolic_operator"
            ]
          },
          "declared_role": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "symbolic_equations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "epistemic_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "genealogy_is_metaphysical_proof",
        "symbolism_is_biological_fact",
        "symbolism_is_scientific_evidence",
        "third_party_reference_implies_affiliation",
        "pattern_is_proof",
        "human_agency_over_machine_authority"
      ],
      "properties": {
        "genealogy_is_metaphysical_proof": {
          "const": false
        },
        "symbolism_is_biological_fact": {
          "const": false
        },
        "symbolism_is_scientific_evidence": {
          "const": false
        },
        "third_party_reference_implies_affiliation": {
          "const": false
        },
        "pattern_is_proof": {
          "const": false
        },
        "human_agency_over_machine_authority": {
          "const": true
        }
      }
    },
    "privacy_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publish_raw_family_tree",
        "publish_invite_tokens",
        "publish_living_relative_details",
        "retain_only_minimum_public_claim"
      ],
      "properties": {
        "publish_raw_family_tree": {
          "const": false
        },
        "publish_invite_tokens": {
          "const": false
        },
        "publish_living_relative_details": {
          "const": false
        },
        "retain_only_minimum_public_claim": {
          "const": true
        }
      }
    },
    "third_party_notice": {
      "type": "string",
      "minLength": 1
    }
  }
}
